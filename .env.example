# example — copy to .env (never commit real .env)
DATABASE_URL=postgresql://user:pass@host/techintel?sslmode=require
LOG_LEVEL=info

# Ingestion (all optional; worker runs without them at lower limits)
HN_API_BASE=https://hacker-news.firebaseio.com/v0
GITHUB_TOKEN=
# PRODUCTHUNT_TOKEN=   # uncomment to enable producthunt source
# X_API_BEARER=        # uncomment to enable x-tech source

# AI enrichment (default none = feed works without AI)
AI_PROVIDER=none
# AI_PROVIDER=openai
# AI_API_BASE=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini

# Web
# TRENDING_WINDOW_HOURS=48
