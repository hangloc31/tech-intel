{
  "name": "tech-intel",
  "version": "0.1.0",
  "private": true,
  "description": "Tech Intelligence / Tech News Aggregator - one place to understand what is happening in technology right now.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "vitest run --project unit",
    "lint": "echo 'lint: tsc --noEmit per workspace (eslint added in M2)'",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "worker": "npm run worker --workspace=packages/ingestion --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
